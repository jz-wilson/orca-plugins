{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-catalog.v2.schema.json",
  "catalogVersion": 2,
  "name": "jz-wilson Orca plugins",
  "owner": "jz-wilson",
  "plugins": [
    {
      "id": "jz-wilson.cache-clock",
      "source": {
        "kind": "git",
        "url": "https://github.com/jz-wilson/orca-plugins.git",
        "ref": "main",
        "path": "plugins/cache-clock"
      },
      "description": "Status bar countdown until an agent's prompt cache goes cold.",
      "categories": ["agents", "status-bar"],
      "releases": [
        {
          "version": "0.1.0",
          "commit": "6127b352ec5c975a74ebec90d936a9e1e619a03f",
          "contentHash": "73717ef8b293a18a381b009ba58607f5bb962340d8e4bd887a9b7b19065b2526",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Cache Clock",
          "license": "MIT",
          "repository": "https://github.com/jz-wilson/orca-plugins",
          "contributes": [
            { "kind": "events", "name": "agent.status.changed" },
            { "kind": "statusBarItems", "name": "cache" }
          ],
          "capabilities": ["agent:read"]
        }
      ]
    },
    {
      "id": "jz-wilson.helpin-tasks",
      "source": {
        "kind": "git",
        "url": "https://github.com/jz-wilson/orca-plugins.git",
        "ref": "main",
        "path": "plugins/helpin-tasks"
      },
      "description": "Sidebar panel of open Helpin tasks; Start opens a workspace on a new branch with an agent on the task.",
      "categories": ["agents", "tasks"],
      "releases": [
        {
          "version": "0.1.0",
          "commit": "31b39329e512983f17ffd57da65154e9271e03a9",
          "contentHash": "15cfdb9f558ece003b8380885ea805e07d6576ce827fb838fd53682186d51ce8",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.259",
          "name": "Helpin Tasks",
          "license": "MIT",
          "repository": "https://github.com/jz-wilson/orca-plugins",
          "contributes": [{ "kind": "panels", "name": "Helpin Tasks" }],
          "capabilities": ["settings:own", "secrets:own", "workspace:read", "workspace:create", "agent:launch"]
        }
      ]
    }
  ]
}
